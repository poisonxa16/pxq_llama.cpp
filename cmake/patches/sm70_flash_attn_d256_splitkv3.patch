+                "split-KV3 inputs and workspaces must be CUDA tensors");
+    TORCH_CHECK(q.scalar_type() == at::ScalarType::Half
+                    && k.scalar_type() == q.scalar_type()
+                    && v.scalar_type() == q.scalar_type()
