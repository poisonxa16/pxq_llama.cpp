+    TORCH_CHECK(q.size(2) % k.size(2) == 0,
+                "split-KV3 query heads must be divisible by KV heads");
+    TORCH_CHECK(k.size(1) > q.size(1),
+                "split-KV3 requires prefix prefill");
+    TORCH_CHECK(q.size(1) % Sm70D256SplitDTraits::kBlockM == 0
